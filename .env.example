# Environment variables for API Sandbox Links.
# Copy to .env and fill in actual values. .env is gitignored and never committed.
# The backend loads .env from its working directory, so run from the repo root.

# Database
APP_ENV=development

DATABASE_URL=postgres://user:pass@localhost:5434/sandbox_platform # CHANGE FOR YOUR ENV
REDIS_URL=redis://localhost:6380 # CHANGE FOR YOUR ENV

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8080/api/auth/github/callback

# AI (optional; features degrade gracefully when empty)
GEMINI_API_KEY=

# Encryption key - 32 random bytes, base64 encoded
# Generate: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# GitHub webhook secret (hex-encoded 64-char string)
GITHUB_WEBHOOK_SECRET=

# Optional overrides
DOCKER_HOST=
NIXPACKS_BIN=nixpacks
SANDBOX_WORK_DIR=

# Server ports
BACKEND_PORT=8080
GATEWAY_PORT=8090

# Application URLs
FRONTEND_URL=http://localhost:3000
SANDBOX_BASE_DOMAIN=sandbox.localhost

# Abuse controls / build capacity (defaults shown)
# MAX_LIFETIME_SECONDS=604800
# MAX_ACTIVE_SANDBOXES_PER_USER=3
# MAX_RUNNING_SANDBOXES=6
# BUILD_CONCURRENCY=2