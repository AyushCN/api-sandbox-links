# Frontend environment variables.
# Copy to .env.local and edit the link below. .env.local is gitignored.

# Public origin of the backend API. This is the single "API link" the frontend
# uses (rewrite proxy, route handlers, and browser WebSocket fallback).
NEXT_PUBLIC_API_BASE=http://localhost:8080

# WebSocket origin. Defaults to NEXT_PUBLIC_API_BASE (http -> ws) when unset.
# Set explicitly only if the WS host differs from the API host.
# NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Optional server-only override for the rewrite proxy and route handlers.
# Leave unset unless the backend must be reached at an internal URL that
# differs from the browser-facing NEXT_PUBLIC_API_BASE.
# BACKEND_URL=http://localhost:8080
